# Copy to .env and fill in
PORT=4100
NODE_ENV=development

# Frontend origin allowed by CORS (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Firebase Admin credentials — downloaded from Firebase console → Project
# settings → Service accounts. Use ONE of the following:
#   - local dev: a file path
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
#   - hosted deploys with no local filesystem secret (Render, Cloud Run):
#     paste the full JSON file content as one line
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Google Maps server key (IP-restricted; used for Directions/Geocoding/Distance Matrix)
GOOGLE_MAPS_SERVER_KEY=

# First super admin account, created by `npm run seed:admin` (one-time).
# Leave SEED_ADMIN_PASSWORD blank to have the script generate one and print it once.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Error tracking (Sentry) — sentry.io → New Project → Node.js, copy the DSN.
# Optional: leave blank and errors are just logged to the console as before.
SENTRY_DSN=
