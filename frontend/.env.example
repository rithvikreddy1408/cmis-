# Copy to .env and fill in from Firebase console → Project settings → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend origin, no trailing slash — e.g. https://cmis-backend.onrender.com
# REQUIRED in any deployment where the frontend and backend are on different
# hosts. Leave BLANK for local dev: Vite proxies /api and /socket.io to the
# backend, so a relative path is already correct. If this is blank in a
# deployment, every API call resolves against the static host and returns
# index.html instead of JSON, and nothing loads.
VITE_API_URL=

# Google Maps JavaScript API key (browser key, referrer-restricted).
# Only the admin Route Builder needs this — the dashboard and student
# tracking maps use OpenStreetMap tiles and work without any key.
VITE_GOOGLE_MAPS_API_KEY=

# Web Push (FCM) — Firebase console → Project settings → Cloud Messaging →
# "Web configuration" → generate a key pair. Optional: without it, push
# notifications are silently unavailable (Notification.requestPermission
# still works but getToken() has nothing to authenticate with) — everything
# else in the app functions normally.
VITE_FIREBASE_VAPID_KEY=

# Error tracking (Sentry) — sentry.io → New Project → React, copy the DSN.
# Optional: leave blank and errors are just logged to the console as before.
VITE_SENTRY_DSN=
